    "seed": "tsx src/cli/seed.ts",
    "bot": "tsx src/cli/bot.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@fastify/cors": "11.3.0",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/websocket": "11.3.0",
    "@nimiq/core": "2.21.0",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.3",
    "postgres": "3.4.9",
    "tsx": "4.23.13",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "@types/ws": "8.18.1",
    "drizzle-kit": "0.31.10",
    "fast-check": "4.10.0",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
