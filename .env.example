# Copy this to packages/server/.env and fill it in. Never commit the filled-in file.

# HTTP and WebSocket port the world listens on.
PORT=8788

# Postgres connection string. Leave blank to run on PGlite under packages/server/.data/vettai.
DATABASE_URL=

# Nimiq JSON-RPC node. https://rpc.testnet.nimiqwatch.com for testnet, https://rpc.nimiqwatch.com for mainnet.
NIMIQ_RPC_URL=https://rpc.testnet.nimiqwatch.com

# Must match the node above: TestAlbatross or MainAlbatross.
NIMIQ_NETWORK=TestAlbatross

# The address that pays players and receives shop payments.
TREASURY_ADDRESS=

# 64 hex characters, the key that signs payouts. It does not belong in this file: put it in
# packages/server/.env.treasury, which only the treasury process reads. The world refuses to
# start if it finds this key in its own environment.
# TREASURY_PRIVATE_KEY=

# Hard stop in NIM: queued plus sent plus paid claims never go past this.
POOL_TOTAL_NIM=100

# What one wallet can take in a UTC day in NIM, across every reward kind.
DAILY_CAP_NIM=5

# Distinct wallets that may claim from one IP per UTC day.
IP_WALLETS_PER_DAY=2

# Comma separated browser origins allowed to call the API. Blank means same-origin only.
ALLOWED_ORIGINS=

# Seed the city is generated from. Changing it builds a different map.
MAP_SEED=vettai-1

# Secret mixed into the hash of a caller's IP. Set a long random string in production.
IP_SALT=

# Which proxies may say where a caller came from, as a comma list Fastify understands:
# addresses, subnets, or the names loopback, linklocal and uniquelocal. Blank trusts nobody
# and is right locally. On Railway the edge reaches the container over the private network,
# so uniquelocal is the value there. Never true. Check it after a deploy with GET /api/echo-ip:
# it must show your own address, not the edge's.
TRUST_PROXY=

# Quest payouts in NIM. Leave blank to use the defaults in ARCHITECTURE.md.
REWARD_HUNT=
REWARD_COURIER=
REWARD_LANDMARKS=
REWARD_LANDMARKS_REPEAT=
REWARD_LANDLORD=

# The weekly ladder's top three prizes in NIM, in order.
LADDER_PRIZES_NIM=

# Set to src/treasury/index.ts to run the treasury instead of the world.
VETTAI_PROCESS=

# Landlord quest: a real stake by the player, read through RPC. Off until Ram enables it.
LANDLORD_ENABLED=false
LANDLORD_MIN_NIM=10
